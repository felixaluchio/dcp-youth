rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Events: Publicly readable for rallies, videos, and photo gallery; authenticated admin writes
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Members: Publicly countable and readable for Live System Counter, public registration creation, admin management
    match /members/{memberId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
